{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hearme",
  "version": "0.1.0",
  "identifier": "dev.josean.hearme",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "hearme",
        "url": "index.html",
        "visible": false,
        "width": 760,
        "height": 560
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "visible": false,
        "width": 280,
        "height": 64,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to hearme",
        "url": "onboarding.html",
        "visible": false,
        "width": 560,
        "height": 540
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
